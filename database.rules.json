{
  "rules": {
    "users": {
      "$emailKey": {
        ".read": "auth != null && (\n  auth.token.email.replace('.', ',') === $emailKey ||\n  (data.child('coachEmailKey').exists() &&\n   auth.token.email.replace('.', ',') === data.child('coachEmailKey').val())\n)",

        ".write": "auth != null && (\n  auth.token.email.replace('.', ',') === $emailKey ||\n  (data.child('coachEmailKey').val() !== null &&\n   auth.token.email.replace('.', ',') === data.child('coachEmailKey').val())\n)",

        // Journal RGPD : la DATE du dernier export, et rien d autre. Ni son
        // contenu, ni sa taille, ni ce qui a ete demande. /users n a pas de
        // "$autre": false — l ecriture passerait donc sans cette regle — mais
        // on nomme le champ pour qu il soit BORNE et que la structure reste
        // lisible : un journal qui grossirait sans contrainte finirait par
        // porter autre chose qu une date.
        "rgpd": {
          "dernierExport": { ".validate": "newData.isNumber()" },
          "$autre": { ".validate": false }
        },

        // ── Abonnement : liste blanche, meme patron que sante_privee ───────
        // Le coach n a AUCUN besoin de lire ces champs — il ne decide ni du
        // paiement ni de la resiliation. La regle .read du parent le laisse
        // techniquement passer, mais rien dans le produit ne l y amene, et la
        // liste blanche empeche qu un champ imprevu vienne s y loger.
        //
        // renonciationRetractation.accepte porte un consentement JURIDIQUE
        // (art. L221-28 13 du code de la consommation) : il doit rester un
        // booleen horodate, jamais un texte libre ou un objet arbitraire.
        "abonnement": {
          "palier": { ".validate": "newData.isString() && newData.val().length < 40" },
          "prochaineEcheance": { ".validate": "newData.isNumber()" },
          "resiliationDemandee": {
            "ts": { ".validate": "newData.isNumber()" },
            "motif": { ".validate": "newData.isString() && newData.val().length < 300" },
            "$autre": { ".validate": false }
          },
          "renonciationRetractation": {
            "accepte": { ".validate": "newData.isBoolean()" },
            "ts": { ".validate": "newData.isNumber()" },
            "$autre": { ".validate": false }
          },
          "$autre": { ".validate": false }
        },

        // ── Journal de coach : des notes privees, dans le dossier DU COACH ──
        // LA CONFIDENTIALITE NE VIENT PAS D ICI, elle vient du .read ci-dessus :
        // il n ouvre la lecture qu au proprietaire et au coach DE ce document,
        // celui que designe son coachEmailKey. Un athlete n est jamais le coach
        // de son coach — le dossier du coach lui est ferme par construction, et
        // aucune regle nouvelle n etait necessaire pour cela.
        //
        // CE BLOC BORNE, il ne protege pas. /users/$emailKey n a pas de
        // "$autre": false — l ecriture passerait donc sans lui. Mais chaque
        // sauvegarde est un PUT du document ENTIER : un champ de texte libre non
        // borne, dans un document reecrit a chaque fois, finit par deborder le
        // quota. Meme patron que rgpd et abonnement, pour la meme raison.
        //
        // La longueur est celle de NOTE_TEXTE_MAX cote client. Les etiquettes
        // sont la liste fermee de NOTE_TAGS ; null est accepte, c est l absence
        // d etiquette.
        "coachNotes": {
          "$athleteId": {
            "$i": {
              "id":    { ".validate": "newData.isString() && newData.val().length < 40" },
              "at":    { ".validate": "newData.isNumber() && newData.val() > 0" },
              "texte": { ".validate": "newData.isString() && newData.val().length <= 600" },
              "tag":   { ".validate": "newData.val() === null || (newData.isString() && newData.val().matches(/^(blessure|materiel|perso|methode)$/))" },
              "$autre": { ".validate": false }
            }
          }
        },

        "coachEmailKey": {
          ".validate": "auth.token.email.replace('.', ',') === $emailKey || (data.exists() && newData.val() === data.val())"
        }
      }
    },

    // ── Profil coach visible par ses athletes ──────────────────────────────
    // La regle de /users ne va que dans un sens : un coach lit ses athletes,
    // l athlete NE PEUT PAS lire le dossier de son coach. Ni sa photo, ni sa
    // team, ni ses bannieres n arrivaient donc jamais sur le telephone de
    // l athlete ; sur celui du coach tout s affichait, son dossier etant en
    // local. On ne relache PAS /users pour autant : cela donnerait a chaque
    // athlete l acces aux seances, bilans, nutrition et liste de clients du
    // coach. Ce nud ne porte QUE ce qui est destine a etre vu, et n est
    // lisible que par les athletes rattaches a ce coach precis.
    "coach_public": {
      "$emailKey": {
        ".read": "auth != null && (auth.token.email.replace('.', ',') === $emailKey || root.child('users').child(auth.token.email.replace('.', ',')).child('coachEmailKey').val() === $emailKey)",
        ".write": "auth != null && auth.token.email.replace('.', ',') === $emailKey",
        "fname": {
          ".validate": "newData.isString() && newData.val().length < 120"
        },
        "lname": {
          ".validate": "newData.isString() && newData.val().length < 120"
        },
        "teamName": {
          ".validate": "newData.isString() && newData.val().length < 200"
        },
        "catchphrase": {
          ".validate": "newData.isString() && newData.val().length < 400"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length < 40"
        },

        // ── Contact : lisible SEULEMENT si le coach a consenti ─────────────
        // Le .read du parent ouvre coach_public a tout athlete rattache. Un
        // enfant ne peut pas etre plus permissif que son parent, mais il peut
        // etre plus RESTRICTIF : ce noeud n est lisible que si mode vaut autre
        // chose que 'aucun' ET qu un consentement est horodate.
        //
        // Le proprietaire, lui, se lit toujours : sans quoi le coach ne
        // pourrait plus relire son propre reglage pour l afficher.
        "contact": {
          ".read": "auth != null && (auth.token.email.replace('.', ',') === $emailKey || (data.child('mode').val() !== 'aucun' && data.child('mode').exists() && data.child('consentAt').exists()))",
          "mode": {
            ".validate": "newData.isString() && newData.val().matches(/^(aucun|whatsapp|email)$/)"
          },
          "consentAt": {
            ".validate": "newData.isString() && newData.val().length < 40"
          },
          "horaires": {
            ".validate": "newData.isString() && newData.val().length < 200"
          },
          "$autre": { ".validate": false }
        },
        "coachPhoto": {
          ".validate": "newData.isString() && newData.val().length < 400000"
        },
        "promoBanners": {},

        // ── Canal : les DEUX seuls morceaux qui doivent etre connus sans ouvrir
        // l onglet. Ils sont ici, et pas dans /canaux, parce que coach_public
        // est DEJA telecharge a chaque ouverture de l accueil athlete : les y
        // loger ne coute aucune requete de plus, alors qu aller les chercher
        // dans /canaux en couterait une par lancement d application, pour tout
        // le monde, y compris ceux qui n ouvrent jamais le canal.
        //
        // canalDernier : l horodatage du message le plus recent. C est la sonde
        // qui allume la pastille — un entier, pas un fil. Meme idiome que
        // pullUpdatedAt, pour la meme raison.
        //
        // canalEpingle : une COPIE du message epingle, celui qui s affiche en
        // banniere d accueil. La duplication avec /canaux/messages est
        // deliberee : sans elle, afficher la banniere obligerait a tirer le fil
        // entier a chaque ouverture. Elle est bornee aux memes longueurs que le
        // message d origine.
        "canalDernier": { ".validate": "newData.isNumber()" },
        "canalEpingle": {
          "id":    { ".validate": "newData.isString() && newData.val().length < 40" },
          "at":    { ".validate": "newData.isNumber() && newData.val() > 0" },
          "titre": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "texte": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "lien":  { ".validate": "newData.isString() && newData.val().length <= 500" },
          "$autre": { ".validate": false }
        },

        "chargesSchema": {
          "$schema": {
            "$zone": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" }
          }
        },
        "maj": {
          ".validate": "newData.isNumber()"
        },
        "$autre": {
          ".validate": false
        }
      }
    },

    // ── Canal du coach : un fil de diffusion, lu par ses athletes ──────────
    // POURQUOI CE NOEUD N EST PAS DANS coach_public : coach_public est
    // retelecharge EN ENTIER a chaque ouverture de l accueil athlete, pour la
    // photo et la phrase du coach. Y loger le fil ferait descendre tous les
    // messages a chaque lancement de l app, y compris quand personne n ouvre le
    // canal. Ici, rien ne descend tant que l onglet n est pas ouvert. Le plafond
    // du plan Spark est un VOLUME MENSUEL, pas un nombre d utilisateurs : c est
    // cette difference-la qui decide s il est franchi.
    //
    // Le test de lecture est le meme que celui de coach_public : le proprietaire,
    // ou un athlete dont le coachEmailKey designe ce coach. Un athlete SANS coach
    // referent recoit 401 — l onglet grise cote application n est qu un affichage,
    // la serrure est ici.
    // IL N Y A VOLONTAIREMENT AUCUN .read SUR $coachKey. En RTDB les regles
    // CASCADENT : un .read accorde sur un parent ne peut PAS etre repris par un
    // enfant, seulement elargi. Poser ici la lecture « le coach ou ses athletes »
    // aurait donc ouvert /reactions au groupe entier, et la separation ci-dessous
    // n aurait rien protege du tout. La lecture est accordee un cran plus bas,
    // noeud par noeud, ce qui est le seul moyen d en fermer un.
    // Consequence cote client, assumee : le fil se lit en deux requetes
    // (messages, puis compteurs) au lieu d une. C est aussi ce qui garantit que
    // l athlete ne telecharge jamais /reactions.
    "canaux": {
      "$coachKey": {

        // Les messages : le coach ecrit, personne d autre. Liste blanche stricte
        // et longueurs bornees — un noeud lu par tout un groupe ne doit pas
        // pouvoir accueillir un champ imprevu ni un texte sans fin.
        "messages": {
          ".read": "auth != null && (auth.token.email.replace('.', ',') === $coachKey || root.child('users').child(auth.token.email.replace('.', ',')).child('coachEmailKey').val() === $coachKey)",
          ".write": "auth != null && auth.token.email.replace('.', ',') === $coachKey",
          "$msgId": {
            "at":      { ".validate": "newData.isNumber() && newData.val() > 0" },
            "titre":   { ".validate": "newData.isString() && newData.val().length <= 80" },
            "texte":   { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "lien":    { ".validate": "newData.isString() && newData.val().length <= 500" },
            "epingle": { ".validate": "newData.isBoolean()" },
            "$autre":  { ".validate": false }
          }
        },

        // Compteurs PUBLICS, un entier par emoji. C est ce qui donne l affichage
        // « 9 💪 » des canaux Instagram SANS exposer qui est qui : le detail
        // nominatif vit dans /reactions, ferme. Sans cette separation, lire le
        // compteur reviendrait a lire la liste des athletes du coach — RepCore
        // n a jamais laisse un athlete apprendre l existence d un autre.
        //
        // L athlete ne peut faire varier un compteur que de UN, dans un sens ou
        // dans l autre : poser sa reaction, ou la retirer. L increment serveur
        // ({".sv":{"increment":1}}) est resolu AVANT l evaluation des regles,
        // donc .validate voit bien le nombre final.
        //
        // Le coach, lui, ecrit la valeur qu il veut : c est ce qui lui permet de
        // resynchroniser un compteur ayant derive d avec /reactions, quand un
        // telephone a lache entre les deux ecritures.
        //
        // CE QU ON ACCEPTE, ET QU IL FAUT SAVOIR : un athlete rattache qui sait
        // appeler cette URL peut gonfler un compteur en poussant +1 en boucle.
        // Meme compromis assume que /metrics et /coachs_libres — a ceci pres
        // qu il faut ici etre authentifie ET rattache a ce coach precis. Le gain
        // de l attaque est nul et son auteur est identifie.
        // L ecriture athlete exige newData.exists() : sans cela, un athlete
        // pouvait SUPPRIMER le compteur et le remettre a zero d un coup. Un
        // .validate ne l aurait pas arrete — Firebase ne valide pas une
        // suppression, il ne consulte que .write.
        "compteurs": {
          ".read": "auth != null && (auth.token.email.replace('.', ',') === $coachKey || root.child('users').child(auth.token.email.replace('.', ',')).child('coachEmailKey').val() === $coachKey)",
          "$msgId": {
            "$emoji": {
              ".write": "auth != null && (auth.token.email.replace('.', ',') === $coachKey || (newData.exists() && root.child('users').child(auth.token.email.replace('.', ',')).child('coachEmailKey').val() === $coachKey))",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000 && (auth.token.email.replace('.', ',') === $coachKey || (!data.exists() && newData.val() === 1) || (data.exists() && (newData.val() === data.val() + 1 || newData.val() === data.val() - 1)))"
            }
          }
        },

        // Qui a reagi, et avec quoi. C est tout ce qui separe « 9 personnes ont
        // reagi », qui est public, de « voici lesquelles », qui ne l est pas.
        //
        // INDEXE PAR ATHLETE PUIS PAR MESSAGE, et non l inverse. Range par
        // message, un athlete aurait eu besoin d une requete PAR MESSAGE pour
        // retrouver ses propres reactions — vingt appels pour afficher un fil.
        // Range par athlete, il en fait UN et recoit toutes les siennes. Le coach
        // lit le noeud entier et pivote en memoire, ce qui ne coute rien : ce
        // sont ses propres athletes.
        //
        // Les deux .read sont a des profondeurs differentes, et c est le fond de
        // l affaire : celui du coach porte sur /reactions et cascade donc sur
        // tout ; celui de l athlete est un cran plus bas et ne couvre que sa
        // propre feuille. Un athlete ne peut pas lister /reactions.
        "reactions": {
          ".read": "auth != null && auth.token.email.replace('.', ',') === $coachKey",
          "$athleteKey": {
            ".read":  "auth != null && auth.token.email.replace('.', ',') === $athleteKey",
            ".write": "auth != null && auth.token.email.replace('.', ',') === $athleteKey && root.child('users').child($athleteKey).child('coachEmailKey').val() === $coachKey",
            "$msgId": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            }
          }
        },

        "$autre": { ".validate": false }
      }
    },

    // ── Sante privee : hors de portee du coach, par construction ───────────
    // La regle de /users donne au coach un acces LECTURE ET ECRITURE sur le
    // dossier entier de ses athletes, sans aucune granularite. Les blocs que
    // l athlete choisit de ne pas partager — grossesse, produits ameliorant la
    // performance, constantes, analyses — etaient donc SUPPRIMES avant l envoi,
    // faute de mieux. Ils ne survivaient pas a un changement d appareil, et
    // chaque lot concerne portait cette contrepartie en commentaire.
    //
    // Ce noeud la repare : meme confidentialite, mais sauvegardee. Ni .read ni
    // .write ne mentionnent coachEmailKey — un coach ne peut pas lire ce noeud,
    // ne peut pas y ecrire, et ne peut pas savoir qu il existe.
    //
    // Meme patron que coach_public : exposition champ par champ, validations de
    // type et de longueur, et "$autre" qui refuse tout champ non prevu. Une
    // liste blanche cote regles vaut mieux qu une liste noire cote client :
    // celle-ci tient meme si le client est modifie.
    "sante_privee": {
      "$emailKey": {
        ".read": "auth != null && auth.token.email.replace('.', ',') === $emailKey",
        ".write": "auth != null && auth.token.email.replace('.', ',') === $emailKey",

        // Grossesse, allaitement, post-partum. Ni date de terme, ni trimestre :
        // le produit ne les demande pas, les regles ne les acceptent pas.
        "grossesse": {
          "etat": { ".validate": "newData.isString() && newData.val().length < 40" },
          "declareLe": { ".validate": "newData.isNumber()" },
          "msgVu": { ".validate": "newData.isBoolean()" },
          "$autre": { ".validate": false }
        },

        // Produits ameliorant la performance : le FAIT, et rien d autre.
        // Aucune molecule, aucune dose, aucune duree — donc aucun champ pour
        // les recevoir.
        "pes": { ".validate": "newData.isBoolean()" },

        // Contraception : le type declare, pas le produit.
        "contraception": { ".validate": "newData.isString() && newData.val().length < 40" },

        // Constantes physiologiques relevees par l athlete.
        // Constantes physiologiques relevees par l athlete.
        //
        // CES REGLES ONT ETE ECRITES SUR UNE SUPPOSITION, et la supposition
        // etait fausse : elles declaraient {valeur, valeur2, unite} alors que
        // le client emet {sys, dia, pouls} depuis toujours. Aucune constante
        // n aurait pu monter — Firebase rejette TOUT le PUT sur un champ hors
        // liste blanche, silencieusement. Ce sont les regles qui sont alignees
        // sur le client, pas l inverse : sys/dia/pouls sont les noms justes
        // d une tension, valeur/valeur2 ne veulent rien dire.
        //
        // La liste blanche reste STRICTE : on nomme des champs, on n ouvre pas
        // le noeud. Les bornes reprennent TENSION_BORNES cote client.
        "constantes": {
          "$i": {
            "type": { ".validate": "newData.isString() && newData.val().length < 40" },
            "sys": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 300" },
            "dia": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 200" },
            "pouls": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 300" },
            "date": { ".validate": "newData.isString() && newData.val().length < 30" },
            "$autre": { ".validate": false }
          }
        },

        // Horodatage de la migration locale vers ce noeud. Sans lui en liste
        // blanche, l ecriture ENTIERE serait rejetee — c est le meme piege que
        // celui des constantes, une clef de trop suffit.
        "migre": { ".validate": "newData.isNumber()" },

        // Resultats d analyses. RepCore les CONSERVE, ne les interprete pas :
        // aucun champ de valeur de reference, aucun champ de verdict.
        "analyses": {
          "$i": {
            "marqueur": { ".validate": "newData.isString() && newData.val().length < 60" },
            "valeur": { ".validate": "newData.isNumber()" },
            "unite": { ".validate": "newData.isString() && newData.val().length < 20" },
            "date": { ".validate": "newData.isString() && newData.val().length < 30" },
            "$autre": { ".validate": false }
          }
        },

        "maj": { ".validate": "newData.isNumber()" },
        "$autre": { ".validate": false }
      }
    },

    "deleted_accounts": {
      ".read": false,
      ".write": false
    },

    // Lecture ouverte sur UN code precis, jamais sur la collection : l'athlete
    // doit pouvoir verifier son code avant de creer un compte et de consentir au
    // traitement de ses donnees de sante, or il n'a pas encore d'identite
    // Firebase a ce moment-la. L'enumeration reste impossible — lister
    // /rc_codes exigerait un .read sur le parent, qui n'est pas accorde.
    //
    // NE PAS repasser ce .read a "auth != null" sans retirer d'abord la
    // verification prealable : _verifierCodeSansConsommer s'execute AVANT toute
    // inscription, donc sans jeton. Le verrou renverrait 401 pour tout le monde,
    // et l'ecran d'entree deviendrait un cul-de-sac pour chaque athlete.
    //
    // L'ECRITURE, elle, est verrouillee par proprietaire :
    //   - creation : n'importe quel compte connecte peut poser un code neuf ;
    //   - modification/suppression : reservees a l'emetteur, identifie par
    //     coachEmailKey, pose par _genAccessCode ;
    //   - exception unique : un tiers peut faire passer redeemed de false a
    //     true, c'est le rachat par l'athlete. Il ne peut PAS en profiter pour
    //     s'attribuer le code (coachEmailKey doit rester identique), ce qui
    //     fermerait sinon les anciens codes emis avant que cette cle existe.
    // Les .validate par champ empechent qu'une ecriture de rachat legitime
    // serve de cheval de Troie : sans eux, un PATCH {redeemed:true,
    // active:false} passait le .write et desactivait le code au passage.
    "rc_codes": {
      "$code": {
        ".read": true,

        // Une QUATRIEME voie s ajoute ici, et une seule : l ouverture du lien
        // par quelqu un qui n a PAS encore de compte. C est tout l objet du
        // suivi d invitation — un athlete qui ouvre le lien avant de s inscrire
        // ne peut par definition pas etre authentifie.
        //
        // Elle est bornee a l os :
        //   - le noeud doit DEJA exister : on ne peut pas creer un code ainsi ;
        //   - l etat doit passer a 'ouvert', et seulement depuis un etat qui
        //     n est ni 'ouvert' ni 'cree' — le sens unique est tenu par le
        //     serveur, pas seulement par le client ;
        //   - redeemed, active et coachEmailKey doivent rester IDENTIQUES.
        //     Sans ces trois egalites, un PATCH {etat:'ouvert', active:false}
        //     desactiverait le code au passage : c est exactement le cheval de
        //     Troie que les .validate par champ ont deja ferme une fois.
        //
        // CE QU ON ACCEPTE, ET QU IL FAUT SAVOIR : quiconque connait un code
        // valide peut le marquer « ouvert ». Le rayon d action est celui du
        // lien lui-meme — l athlete, ou celui a qui il l a transfere. Sans
        // serveur, une telemetrie d ouverture est necessairement falsifiable ;
        // la difference avec /metrics, qui accepte l ecriture sans rien
        // connaitre, est qu il faut ici detenir le code.
        ".write": "(auth != null && (!data.exists() || data.child('coachEmailKey').val() === auth.token.email.replace('.', ',') || (data.child('redeemed').val() !== true && newData.child('redeemed').val() === true && newData.child('coachEmailKey').val() === data.child('coachEmailKey').val()))) || (data.exists() && newData.child('etat').val() === 'ouvert' && data.child('etat').val() !== 'ouvert' && data.child('etat').val() !== 'cree' && newData.child('redeemed').val() === data.child('redeemed').val() && newData.child('active').val() === data.child('active').val() && newData.child('coachEmailKey').val() === data.child('coachEmailKey').val())",

        // Trois etats, dans cet ordre, et rien d autre.
        "etat":     { ".validate": "newData.isString() && newData.val().matches(/^(envoye|ouvert|cree)$/)" },
        // Horodatages ISO. Bornes en longueur : un champ texte libre dans un
        // noeud public finit par porter autre chose qu une date.
        "ouvertLe":  { ".validate": "newData.isString() && newData.val().length < 40" },
        "creeLe":    { ".validate": "newData.isString() && newData.val().length < 40" },
        "relanceLe": { ".validate": "newData.isString() && newData.val().length < 40" },
        // Prenom et nom saisis par le coach. RIEN D AUTRE de nominatif n entre
        // ici : le noeud est en lecture publique.
        "prenom": { ".validate": "newData.isString() && newData.val().length < 60" },
        "nom":    { ".validate": "newData.isString() && newData.val().length < 60" },

        "coachEmailKey": { ".validate": "!data.exists() || data.val() === newData.val()" },
        "coachId":       { ".validate": "!data.exists() || data.val() === newData.val()" },

        "active":      { ".validate": "!data.exists() || data.val() === newData.val() || data.parent().child('coachEmailKey').val() === auth.token.email.replace('.', ',')" },
        "expiry":      { ".validate": "!data.exists() || data.val() === newData.val() || data.parent().child('coachEmailKey').val() === auth.token.email.replace('.', ',')" },
        "months":      { ".validate": "!data.exists() || data.val() === newData.val() || data.parent().child('coachEmailKey').val() === auth.token.email.replace('.', ',')" },
        "creatorFree": { ".validate": "!data.exists() || data.val() === newData.val() || data.parent().child('coachEmailKey').val() === auth.token.email.replace('.', ',')" },
        "type":        { ".validate": "!data.exists() || data.val() === newData.val() || data.parent().child('coachEmailKey').val() === auth.token.email.replace('.', ',')" }
      }
    },

    // Mesure de tunnel — DES COMPTEURS, RIEN D'AUTRE.
    // Un noeud par jour, un entier par etape. Aucun identifiant, aucun email,
    // aucune donnee de sante ne peut y entrer : la validation n'accepte qu'un
    // nombre, sous une cle appartenant a une liste fermee de 15 noms. Toute
    // autre cle ou tout autre type est refuse par le serveur — la garantie ne
    // repose donc pas sur la bonne conduite du client.
    // Ecriture non authentifiee : le visiteur de la page d'accueil n'a pas de
    // compte, c'est justement le debut du tunnel qu'on mesure.
    // Contrepartie assumee : les compteurs sont gonflables par quiconque sait
    // les appeler. La croissance seule est autorisee (pas de remise a zero),
    // et le plafond evite qu'un seul appel rende la mesure absurde.
    // Lecture reservee aux comptes connectes ; l'ecran est en outre reserve au
    // createur cote application.
    "metrics": {
      "$jour": {
        ".read": "auth != null",
        ".validate": "$jour.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        "$evenement": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 10000000 && (!data.exists() || newData.val() > data.val()) && $evenement.matches(/^(landing_view|welcome_view|role_selected_coach|role_selected_athlete|code_entered|code_valid|code_invalid|register_started|register_completed|subscribe_viewed|paypal_clicked|subscription_activated|first_workout_started|first_workout_completed|first_bilan_completed)$/)"
        }
      }
    },

    // Nombre de comptes coach ouverts au palier Libre. UN ENTIER, et rien
    // d autre : aucune identite, aucune date, aucune donnee de sante. Il sert
    // a fermer l inscription gratuite au-dela de LIBRE_MAX, plafond de ce que
    // le plan Spark porte sans degrader le service de ceux qui l utilisent.
    //
    // Lecture PUBLIQUE, et c est necessaire : la decision se prend avant que
    // le visiteur ait un compte, donc avant qu il ait un jeton.
    //
    // Ecriture reservee aux comptes authentifies, et bornee a « +1 ». La
    // difference avec /metrics est deliberee : metrics accepte l ecriture sans
    // authentification, ce qui rend ses compteurs gonflables par quiconque —
    // acceptable pour une mesure de tunnel, disqualifiant pour un plafond, qui
    // se ferait pousser a dix millions et fermerait l inscription a tout le
    // monde. Ici, un compte est necessaire, et chaque ecriture n avance que
    // d une unite : ouvrir 200 fausses places demande 200 comptes Firebase.
    //
    // Aucune remise a zero, aucun saut : n doit valoir exactement le precedent
    // plus un, ou 1 si le noeud n existe pas encore.
    "coachs_libres": {
      ".read": true,
      ".write": "auth != null && newData.hasChild('n') && ((!data.exists() && newData.child('n').val() === 1) || (data.exists() && newData.child('n').val() === data.child('n').val() + 1))",
      "n": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 1000000" },
      "$autre": { ".validate": false }
    },

    // Banque d exercices : 406 fiches, illustration mise a part.
    //
    // LECTURE RESERVEE AUX COACHS, et c est le SEUL controle d acces reel dont
    // ce projet dispose : il n y a pas de serveur, pas de middleware, pas
    // d endpoint a proteger. Un athlete qui appelle cette URL avec son jeton
    // recoit 401, et ce n est pas une question d interface.
    // Le createur est coach, il passe donc par la meme regle.
    //
    // CE QUI N EST PAS PROTEGE, ET QU IL FAUT SAVOIR : les ILLUSTRATIONS sont
    // des fichiers statiques de app/exercices/, servis publiquement par GitHub
    // Pages. Leur URL est devinable depuis le nom de l exercice. C est assume :
    // les proteger demanderait un serveur. Et c est ce qui permet a un athlete
    // de voir l illustration des exercices que son coach lui a prescrits sans
    // qu on lui ouvre le catalogue — exactement ce que le cahier des charges
    // demande, obtenu sans couche d hydratation cote serveur.
    //
    // ECRITURE : le createur seul. Le seeding est un acte de publication, pas
    // une action de produit ; aucun ecran n ecrit ici.
    "exercices": {
      ".read": "auth != null && root.child('users').child(auth.token.email.replace('.', ',')).child('role').val() === 'coach'",
      ".write": "auth != null && auth.token.email === 'guellec.coachingpro@gmail.com'"
    }
  }
}
